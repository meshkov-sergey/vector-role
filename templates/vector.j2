data_dir: {{ vector_data_dir }}

sources:
  demo_logs:
    type: demo_logs
    format: json
    interval: 1

sinks:
  to_clickhouse:
    type: clickhouse
    inputs:
      - demo_logs
    endpoint: "http://{{ clickhouse_host }}:8123"
    table: "logs"
    database: "logs"
    skip_unknown_fields: true
    auth:
      strategy: "basic"
      user: "default"
      password: ""
    healthcheck: false
